# Database Configuration
DATABASE_PATH=data/leads.db

# Ollama / Local Inference Configuration
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# Outbound SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=export@example.com
SMTP_PASSWORD=app_specific_password_here
SENDER_NAME=Garment Export Ops

# Dispatch Throttling & Limits
DISPATCH_MIN_DELAY_SECONDS=150
DISPATCH_MAX_DELAY_SECONDS=360
DISPATCH_DAILY_LIMIT=25

# Scraper & Proxy Configuration
PROXIES_FILE=data/proxies.txt
HEADLESS=true
